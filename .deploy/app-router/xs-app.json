{
  "welcomeFile": "/launchpad.html",
  "authenticationMethod": "route",
  "routes": [
    {
      "source": "^/odata/(.*)$",
      "target": "/odata/$1",
      "destination": "srv-api",
      "authenticationType": "xsuaa",
      "csrfProtection": true
    },
    {
      "source": "^/resources/(.*)$",
      "target": "$1",
      "localDir": "resources",
      "authenticationType": "none"
    },
    {
      "source": "^/test-resources/(.*)$",
      "target": "$1",
      "localDir": "resources",
      "authenticationType": "none"
    },
    {
      "source": "^/(assets|employees|departments|categories|vendors|maintenance|archive|dashboard|managerdashboard|userdashboard)/?$",
      "target": "$1/index.html",
      "localDir": "resources",
      "authenticationType": "xsuaa"
    },
    {
      "source": "^/(assets|employees|departments|categories|vendors|maintenance|archive|dashboard|managerdashboard|userdashboard)/(.*)$",
      "target": "$1/$2",
      "localDir": "resources",
      "authenticationType": "xsuaa"
    },
    {
      "source": "^/launchpad.html$",
      "target": "launchpad.html",
      "localDir": "resources",
      "authenticationType": "xsuaa"
    }
  ]
}
